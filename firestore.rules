rules_version = '2';
// Sideline (abmendel.github.io/sideline) — Firestore rules for the sideline-d7fc1 project.
// Your own picks sync between devices under a long random sync code. Only someone holding the
// code can read or change that one document; nothing can be listed or deleted.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sideline/{code} {
      allow get: if code.size() >= 20;
      allow create, update: if code.size() >= 20
        && request.resource.data.keys().hasOnly(['nba','nfl','mlb','nhl','soccer','updated']);
    }
  }
}
